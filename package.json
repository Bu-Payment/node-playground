{
  "name": "@bu-payment/node-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "bun run build:sdk:js && bun run build:sdk:types",
    "build:sdk:js": "tsup node_modules/@bu-payment/node-sdk/src/index.ts node_modules/@bu-payment/node-sdk/src/browser-guard.ts --format esm,cjs --platform node --target node20 --out-dir node_modules/@bu-payment/node-sdk/dist --clean",
    "build:sdk:types": "tsc -p tsconfig.sdk.json",
    "dev": "bun --watch src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "build": "tsup src/main.ts --format esm --platform node --target node20 --out-dir dist --clean",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "bun run lint && bun run typecheck && bun run test:coverage && bun run build"
  },
  "dependencies": {
    "@bu-payment/node-sdk": "github:Bu-Payment/node-sdk#19cd868",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/express": "^5.0.3",
    "@types/node": "22.10.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.1.4",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  },
  "packageManager": "bun@1.3.14"
}
