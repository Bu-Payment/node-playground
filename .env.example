# Confidential application identifier issued by the BuPayment dashboard.
BUPAYMENT_APP_ID=

# Confidential key identifier. Its bup_ck_test_ or bup_ck_live_ prefix decides the environment,
# so a Test credential cannot be pointed at live by configuration alone.
BUPAYMENT_KEY_ID=

# Confidential HMAC secret, bup_sec_ followed by 32 bytes of unpadded Base64URL.
# Never commit it, never log it, never expose it to a browser.
BUPAYMENT_SECRET=

# Absolute base URL of the BuPayment API. HTTPS, or plain HTTP only on loopback.
BUPAYMENT_API_BASE_URL=http://localhost:3000

# Interface and port the playground listens on. Defaults to 127.0.0.1:9003.
HOST=127.0.0.1
PORT=9003

# Where the merchant catalogue is written. Defaults to var/catalogue.json.
CATALOGUE_STORE_PATH=var/catalogue.json

# Webhook endpoint secret, the whsec_ value returned once when the endpoint is created.
# Optional: without it POST /webhooks/bupayment answers 503. Never log it.
# Registering the endpoint: https://github.com/Bu-Payment/api/blob/main/docs/webhooks/09-testing-locally.md
# BUPAYMENT_WEBHOOK_SECRET=whsec_...

# Slug of the App's checkout destination, configured in the dashboard with its success and cancel
# URLs. Optional: POST /checkout falls back to a hosted checkout only when it is set and the
# provider cannot charge directly; without it that case answers 503.
# BUPAYMENT_CHECKOUT_DESTINATION=

# Provider for the hosted checkout, for an environment with no default provider.
# BUPAYMENT_CHECKOUT_PROVIDER=trust-my-travel
